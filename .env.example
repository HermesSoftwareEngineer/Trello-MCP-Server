FLASK_ENV=development
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=8000

# Chave mestra usada para criptografar as credenciais do Trello em repouso
# e para assinar a sessao do Flask. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ATENCAO: trocar essa chave torna as credenciais ja salvas ilegiveis.
APP_SECRET_KEY=

# Caminho do banco SQLite (relativo a raiz do projeto ou absoluto)
DATABASE_PATH=instance/trello_mcp.sqlite3

# URL publica do servidor. Alem de aparecer no painel, e o issuer do OAuth:
# precisa ser exatamente a URL por onde os clientes chegam (com https em prod).
PUBLIC_BASE_URL=http://localhost:8000

# OAuth 2.0 (opcional -- estes sao os defaults). Em segundos.
# OAUTH_CODE_TTL=600
# OAUTH_ACCESS_TOKEN_TTL=2592000
# OAUTH_REFRESH_TOKEN_TTL=15552000

# Power-Up de checklists (projeto trello-power). Sem estes valores a tool
# manage_powerup_checklists responde que nao esta configurada.
# Na VPS, pela rede docker interna: http://trello-power:5000/api
# POWERUP_API_URL=
# Mesmo valor de POWERUP_API_KEY no .env do trello-power.
# POWERUP_API_KEY=
