FLASK_ENV=development
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=8000

# Chave mestra usada para criptografar as credenciais do Trello em repouso
# e para assinar a sessao do Flask. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ATENCAO: trocar essa chave torna as credenciais ja salvas ilegiveis.
APP_SECRET_KEY=

# Caminho do banco SQLite (relativo a raiz do projeto ou absoluto)
DATABASE_PATH=instance/trello_mcp.sqlite3

# URL publica do servidor, exibida no painel nas instrucoes de conexao
PUBLIC_BASE_URL=http://localhost:8000
